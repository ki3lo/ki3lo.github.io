---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import { CATEGORIES, SITE_TITLE, slugify, withBase } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	seriesPosts: CollectionEntry<'blog'>[];
};

const { id, title, titleEn, description, pubDate, updatedDate, heroImage, category, tags, series, draft, seriesPosts, htmlContent } =
	Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const body = htmlContent.replaceAll('__BASE__', base);
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: title,
	alternativeHeadline: titleEn,
	datePublished: pubDate.toISOString().slice(0, 10),
	...(updatedDate ? { dateModified: updatedDate.toISOString().slice(0, 10) } : {}),
	inLanguage: ['ko', 'en'],
	keywords: tags.join(', '),
	author: { '@type': 'Person', name: SITE_TITLE },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
};
const seriesIndex = seriesPosts.findIndex((post) => post.id === id);
const prev = seriesPosts[seriesIndex - 1];
const next = seriesPosts[seriesIndex + 1];
---

<html lang="ko">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<style>
			.lang-switch {
				display: inline-flex;
				margin: 0 0 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				overflow: hidden;
			}
			.lang-switch[hidden] {
				display: none;
			}
			.lang-switch button {
				padding: 0.4em 1.1em;
				border: 0;
				background: white;
				color: rgb(var(--gray-dark));
				font: inherit;
				font-size: 0.85em;
				cursor: pointer;
			}
			.lang-switch button[aria-pressed='true'] {
				background: rgb(var(--gray-dark));
				color: white;
			}
			.reading-time:not(:empty)::before {
				content: ' · ';
			}
			:global(.post-body [hidden]) {
				display: none;
			}
			:global(.js .lang-nav) {
				display: none;
			}
			:global(.post-body blockquote) {
				font-size: 1em;
			}
			:global(.post-body pre) {
				position: relative;
				overflow-x: auto;
				background: #f6f8fa;
				font-size: 0.85em;
			}
			:global(.post-body .copy-btn) {
				position: absolute;
				top: 6px;
				right: 6px;
				padding: 2px 8px;
				border: 1px solid #d0d7de;
				border-radius: 6px;
				background: white;
				font-size: 12px;
				cursor: pointer;
			}
			:global(.post-body h2) {
				scroll-margin-top: 1em;
			}
			.sticky-toc {
				display: none;
			}
			.sticky-toc a {
				display: block;
				padding: 0.25em 0;
				color: rgb(var(--gray));
			}
			.sticky-toc a.on {
				color: rgb(var(--gray-dark));
				font-weight: bold;
			}
			@media (min-width: 1240px) {
				.sticky-toc:not([hidden]) {
					display: block;
					position: fixed;
					top: 6em;
					left: calc(50% + 380px);
					width: 220px;
					max-height: 70vh;
					overflow-y: auto;
					font-size: 0.8em;
				}
				:global(.js .post-body .toc) {
					display: none;
				}
			}
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
			}
			.title h1 {
				margin: 0.3em 0;
				font-size: 2.2em;
			}
			.meta {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.meta a {
				color: inherit;
			}
			.draft {
				padding: 0 0.5em;
				border-radius: 4px;
				background: #ffe8a3;
				color: #6b4e00;
			}
			.series {
				margin: 1.5em 0;
				padding: 0.8em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: white;
				font-size: 0.85em;
			}
			.series ol {
				margin: 0.5em 0 0;
			}
			.series .current {
				font-weight: bold;
			}
			.series-nav {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 3em;
				font-size: 0.85em;
			}
			.series-nav .next {
				margin-left: auto;
				text-align: right;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="meta">
							<a href={withBase(`/categories/${category}/`)}>{CATEGORIES[category].label}</a>
							{' · '}
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<>
										{' · 수정 '}
										<FormattedDate date={updatedDate} />
									</>
								)
							}
							{draft && <span class="draft">초안</span>}
							<span id="reading-time" class="reading-time"></span>
						</div>
						<h1 id="post-title" data-ko={title} data-en={titleEn}>{title}</h1>
						<TagList tags={tags} />
						<hr />
					</div>

					{
						series && (
							<nav class="series" aria-label="시리즈 목차">
								<a href={withBase(`/series/${slugify(series)}/`)}>
									<strong>{series}</strong>
								</a>{' '}
								시리즈 ({seriesIndex + 1}/{seriesPosts.length})
								<ol>
									{seriesPosts.map((post) => (
										<li class={post.id === id ? 'current' : undefined}>
											{post.id === id ? (
												post.data.title
											) : (
												<a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
											)}
										</li>
									))}
								</ol>
							</nav>
						)
					}

					<div class="lang-switch" id="lang-switch" role="group" aria-label="Language" hidden>
						<button type="button" data-lang="ko">한국어</button>
						<button type="button" data-lang="en">English</button>
					</div>
					<div class="post-body" set:html={body} />

					{
						(prev || next) && (
							<nav class="series-nav" aria-label="시리즈 이전·다음 글">
								{prev && <a href={withBase(`/blog/${prev.id}/`)}>← {prev.data.title}</a>}
								{next && (
									<a class="next" href={withBase(`/blog/${next.id}/`)}>
										{next.data.title} →
									</a>
								)}
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<aside class="sticky-toc" id="sticky-toc" aria-label="목차" hidden></aside>
		<Footer />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script is:inline src={`${base}/post.js`}></script>
	</body>
</html>
