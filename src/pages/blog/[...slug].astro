---
import BlogPost from '../../layouts/BlogPost.astro';
import { slugify } from '../../consts';
import { getPosts, groupBySeries, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const series = groupBySeries(posts);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			seriesPosts: post.data.series ? series.get(slugify(post.data.series))!.posts : [],
		},
	}));
}

interface Props {
	post: Post;
	seriesPosts: Post[];
}

const { post, seriesPosts } = Astro.props;
---

<BlogPost {...post.data} id={post.id} seriesPosts={seriesPosts} />
